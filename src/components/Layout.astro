---
import type { Language } from '../lib/locale';
const {language,title} = Astro.props as {language:Language;title:string};
---
<!doctype html><html lang={language}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} — ForgeNord Vote</title></head><body><header><a href="/">ForgeNord Vote</a><nav aria-label={language==='fr'?'Langue':'Language'}><a href={`${Astro.url.pathname}?lang=fr`} lang="fr" aria-current={language==='fr'?'page':undefined}>FR</a> · <a href={`${Astro.url.pathname}?lang=en`} lang="en" aria-current={language==='en'?'page':undefined}>EN</a></nav></header><main><slot/></main></body></html>
<style is:global>
body{margin:0;background:#f7f5f0;color:#24231f;font:1rem/1.6 system-ui,sans-serif}header,main{max-width:70rem;margin:auto;padding:1.5rem}header{display:flex;justify-content:space-between;border-bottom:1px solid #ccc}a{color:#603b21}button{background:#603b21;color:#fff;border:0;border-radius:.4rem;padding:.8rem 1.3rem;font:inherit;cursor:pointer}input,textarea,select{font:inherit;max-width:100%;box-sizing:border-box}input:not([type=radio]):not([type=checkbox]),textarea{width:100%;padding:.5rem}label{display:block;margin:.8rem 0}fieldset{border:1px solid #cfc6b7;border-radius:.5rem;margin:1.2rem 0;padding:1rem}:focus-visible{outline:3px solid #80501d;outline-offset:3px}.notice{background:#fff;padding:1rem;border-left:4px solid #603b21}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem}.card{background:#fff;border:1px solid #ddd;border-radius:.6rem;padding:1rem}.card img{width:100%;height:240px;object-fit:contain}.error{color:#8c1822}
</style>
