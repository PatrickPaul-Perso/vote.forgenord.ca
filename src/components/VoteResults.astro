---
import type { Language } from '../lib/locale';
import type { VoteResult } from '../lib/results';
import { safePhoto, safeLink } from '../lib/polls';
const { language, results } = Astro.props as { language: Language; results: VoteResult[] };
const fr = language === 'fr';
const total = results.reduce((sum, result) => sum + result.votes, 0);
const percentage = new Intl.NumberFormat(fr ? 'fr-CA' : 'en-CA', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---
<section class="vote-results" aria-labelledby="results-heading">
  <h2 id="results-heading">{fr ? 'Résultats du vote' : 'Voting results'}</h2>
  <p>{fr ? `${total} votes pour les modèles. Les propositions d’idées sont comptées séparément.` : `${total} votes for models. Idea proposals are counted separately.`}</p>
  <div class="table-scroll">
    <table>
      <caption>{fr ? 'Répartition des votes par modèle' : 'Votes by model'}</caption>
      <thead><tr><th scope="col">{fr ? 'Modèle' : 'Model'}</th><th scope="col">{fr ? 'Votes' : 'Votes'}</th><th scope="col">{fr ? 'Pourcentage' : 'Percentage'}</th></tr></thead>
      <tbody>{results.map(result => {
        const photo = safePhoto(result.image_key);
        const link = safeLink(result.external_url);
        return <tr><th scope="row"><span class="model">{photo && (link ? <a href={link} target="_blank" rel="noopener noreferrer" aria-label={fr ? `Voir ${result.name_fr} dans un nouvel onglet` : `View ${result.name_en} in a new tab`}><img src={photo} alt="" width="48" height="48" loading="lazy"/></a> : <img src={photo} alt="" width="48" height="48" loading="lazy"/>)}<span>{result[`name_${language}`]}{result.archived === 1 && <small> ({fr ? 'archivé' : 'archived'})</small>}</span></span></th><td>{result.votes}</td><td>{percentage.format(total ? result.votes / total * 100 : 0)} %</td></tr>;
      })}</tbody>
    </table>
  </div>
</section>
<style>
.vote-results{margin:1.5rem 0;padding:1rem;background:white;border:1px solid #ddd;border-radius:.5rem}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse}caption{text-align:left;margin-bottom:.5rem}th,td{text-align:left;padding:.5rem;border-bottom:1px solid #eee}td{text-align:right;font-variant-numeric:tabular-nums}.model{display:flex;align-items:center;gap:.75rem}.model img{width:48px;height:48px;object-fit:contain;flex-shrink:0}small{font-weight:400}
</style>
