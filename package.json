{
  "name": "forgenord-vote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types && astro dev --host 0.0.0.0",
    "build": "wrangler types && astro check && astro build",
    "test": "node --test tests/*.test.mjs admin/*.test.mjs",
    "migrate:local": "wrangler d1 migrations apply forgenord-vote-db --local",
    "preview": "astro preview --host 0.0.0.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
